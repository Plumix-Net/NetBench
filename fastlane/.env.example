# Скопируйте в fastlane/.env (он в .gitignore) — fastlane подхватит его сам.
# Где взять каждый ключ — store/README.md, раздел «Ключи для fastlane и CI».

# App Store Connect → Users and Access → Integrations → App Store Connect API (роль App Manager)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Google Cloud → сервисный аккаунт с доступом к приложению в Play Console (JSON-ключ)
PLAY_JSON_KEY_PATH=~/.android-keys/play-service-account.json

# Upload-ключ Android: по умолчанию ~/.android-keys/netbench-upload.jks и .password
# NETBENCH_KEYSTORE=
# NETBENCH_KEY_ALIAS=netbench-upload
# NETBENCH_KEYSTORE_PASSWORD=

