<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <!-- Пакеты Plumix носят версию портируемого upstream (Plumix/docs/VERSIONING.md): Plumix и хосты — Flutter,
         Plumix.Material — material_ui, Plumix.Bloc — flutter_bloc (тянет Plumix.Bloc.Core — bloc), Plumix.Slang —
         slang_flutter; -preview.N до полного паритета. Проверка непубликованного Plumix:
         -p:PlumixVersion=<версия из локального фида> -p:RestoreAdditionalProjectSources=<фид>. -->
    <PlumixVersion>3.47.0-preview.3</PlumixVersion>
    <PlumixMaterialVersion>1.11.1-preview.2</PlumixMaterialVersion>
    <PlumixBlocVersion>9.1.1-preview.1</PlumixBlocVersion>
    <PlumixSlangVersion>4.19.0-preview.1</PlumixSlangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Plumix (мобильный UI: Flutter-подобные виджеты + Bloc) -->
    <PackageVersion Include="Plumix" Version="$(PlumixVersion)" />
    <PackageVersion Include="Plumix.Avalonia" Version="$(PlumixVersion)" />
    <PackageVersion Include="Plumix.Material" Version="$(PlumixMaterialVersion)" />
    <PackageVersion Include="Plumix.Bloc" Version="$(PlumixBlocVersion)" />
    <PackageVersion Include="Plumix.Slang" Version="$(PlumixSlangVersion)" />
    <PackageVersion Include="Plumix.Android" Version="$(PlumixVersion)" />
    <PackageVersion Include="Plumix.iOS" Version="$(PlumixVersion)" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <!-- FileProvider для «Поделиться» (раньше приходил транзитивно через Avalonia.Android) -->
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
    <!-- Установщики и автообновление desktop-версии -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Скриншоты сторов: мобильный UI в headless-окне (NetBench.Screenshots) -->
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <!-- Core packages -->
    <PackageVersion Include="HdrHistogram" Version="2.5.0" />
    <PackageVersion Include="Slang.Net" Version="9.8.0" />
    <!-- DI -->
    <PackageVersion Include="Pure.DI" Version="2.4.3" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
    <!-- Avalonia.Headless.XUnit 12 работает только на xunit v3 — им живут мобильные UI-тесты -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>