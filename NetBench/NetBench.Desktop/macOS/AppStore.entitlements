<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store требует песочницу. Приложению нужны исходящие соединения (цели теста) и
	     файлы, которые пользователь сам выбрал в «Сохранить как» (экспорт отчёта).
	     Данные (сценарии, настройки) лежат в контейнере песочницы. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
