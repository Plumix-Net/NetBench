<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NetBench.Desktop"
             x:Class="NetBench.Desktop.App"
             RequestedThemeVariant="Dark">
             <!-- Дизайн-система NetBench: тёмная тема по умолчанию, светлая — по кнопке в сайдбаре. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://NetBench/Desktop/Themes/Colors.axaml" />
                <ResourceInclude Source="avares://NetBench/Desktop/Themes/Typography.axaml" />
                <ResourceInclude Source="avares://NetBench/Desktop/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://NetBench/Desktop/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
