<!-- Общие стили NetBench поверх FluentTheme: типографическая шкала и варианты контролов. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======== Типографика (классы TextBlock) ======== -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
    </Style>
    <Style Selector="TextBlock.crumbs">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="TextBlock.sechead">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
    </Style>
    <Style Selector="TextBlock.hi">
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
    </Style>
    <Style Selector="TextBlock.mid">
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="TextBlock.err">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Error}" />
    </Style>

    <!-- ======== Кнопки ======== -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Основная (Run/акцент) -->
    <Style Selector="Button.run">
        <Setter Property="Background" Value="{DynamicResource Rps}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Padding" Value="18,9" />
    </Style>
    <Style Selector="Button.run:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RpsHover}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.run:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RpsHover}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.run:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgCardHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <!-- Опасная (Stop) -->
    <Style Selector="Button.stop">
        <Setter Property="Background" Value="{DynamicResource Error}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Padding" Value="18,9" />
    </Style>
    <Style Selector="Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorHover}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorHover}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>

    <!-- Вторичная (ghost) -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgCardHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>

    <!-- Малые иконки-действия в сайдбаре -->
    <Style Selector="Button.sact">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Border}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sact:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgCardHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
    </Style>
    <Style Selector="Button.sact.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Error}" />
    </Style>

    <!-- Кнопка-переключатель темы -->
    <Style Selector="Button.themebtn">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.themebtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgCardHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
    </Style>

    <!-- «+ Новый сценарий» внизу сайдбара -->
    <Style Selector="Button.newbtn">
        <Setter Property="Background" Value="{DynamicResource BgCardHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0,11" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.newbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Border}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
    </Style>

    <!-- ======== Поля ввода ======== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBorder}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rps}" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox.invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
    </Style>
    <Style Selector="TextBox.invalid:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
    </Style>
    <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BgCardHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- ======== Сайдбар (строки сценариев) ======== -->
    <Style Selector="ListBox.scenarios">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="ListBox.scenarios ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.scenarios ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgCardHover}" />
    </Style>
    <Style Selector="ListBox.scenarios ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
    </Style>
    <Style Selector="ListBox.scenarios ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
    </Style>
    <!-- Кнопки-действия строки видны только при наведении -->
    <Style Selector="ListBox.scenarios ListBoxItem StackPanel.sacts">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.scenarios ListBoxItem:pointerover StackPanel.sacts">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ======== Прогресс ======== -->
    <Style Selector="ProgressBar.slim">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="CornerRadius" Value="100" />
        <Setter Property="Background" Value="{DynamicResource Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Rps}" />
    </Style>

    <!-- Пульсирующая точка «Запись» -->
    <Style Selector="Ellipse.recdot">
        <Style.Animations>
            <Animation Duration="0:0:1.2" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.25" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

</Styles>
