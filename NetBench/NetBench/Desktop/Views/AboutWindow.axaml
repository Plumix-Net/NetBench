<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="using:NetBench.Localization"
        x:Class="NetBench.Desktop.Views.AboutWindow"
        Title="{Binding Root.Menu.About, Source={x:Static l10n:Strings.Instance}}"
        Width="400" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPanel}"
        FontFamily="{DynamicResource UiFont}">
    <StackPanel Margin="32,28,32,24" Spacing="6" HorizontalAlignment="Stretch">
        <Image Source="/Assets/netbench.ico" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Root.App.Title, Source={x:Static l10n:Strings.Instance}}"
                   FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource TextHi}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" Classes="mono" FontSize="12"
                   Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Root.About.Description, Source={x:Static l10n:Strings.Instance}}"
                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"
                   Foreground="{DynamicResource TextMid}" Margin="0,10,0,0" />
        <TextBlock Text="{Binding Root.About.PoweredBy, Source={x:Static l10n:Strings.Instance}}"
                   TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextDim}" />

        <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0" ItemSpacing="8" LineSpacing="8">
            <Button x:Name="PrivacyButton" Classes="ghost"
                    Content="{Binding Root.About.Privacy, Source={x:Static l10n:Strings.Instance}}" />
            <Button x:Name="TermsButton" Classes="ghost"
                    Content="{Binding Root.About.Terms, Source={x:Static l10n:Strings.Instance}}" />
            <Button x:Name="FeedbackButton" Classes="ghost"
                    Content="{Binding Root.About.Feedback, Source={x:Static l10n:Strings.Instance}}" />
            <Button x:Name="SourceButton" Classes="ghost"
                    Content="{Binding Root.About.SourceCode, Source={x:Static l10n:Strings.Instance}}" />
        </WrapPanel>

        <TextBlock Text="© 2026 Plumix-Net" FontSize="11" Foreground="{DynamicResource TextFaint}"
                   HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</Window>
