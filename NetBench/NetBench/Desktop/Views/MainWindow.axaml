<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="using:NetBench.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="using:NetBench.Features.Shell.Presentation.Desktop"
        xmlns:vm="using:NetBench.Features.Shell.Presentation.Desktop"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="NetBench.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Root.App.Title, Source={x:Static l10n:Strings.Instance}}"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="640"
        Background="{DynamicResource BgBase}"
        FontFamily="{DynamicResource UiFont}">

    <shell:ShellView />

</Window>
