<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-android</TargetFrameworks>
    <!-- На Linux iOS-workload не существует, и SDK 11 падает на restore (NETSDK1178) -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Linux'))">$(TargetFrameworks);net11.0-ios</TargetFrameworks>
    <!-- Нужен CI: на runner'е без мобильных workloads собираем только desktop (-p:MobileTargets=false) -->
    <TargetFrameworks Condition="'$(MobileTargets)' == 'false'">net11.0</TargetFrameworks>

    <IsMobileTarget>false</IsMobileTarget>
    <IsMobileTarget Condition="$(TargetFramework.Contains('-android')) or $(TargetFramework.Contains('-ios'))">true</IsMobileTarget>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>

    <!-- Версия из Directory.Build.props — её показывает экран «О приложении» (Mobile/AppInfo). -->
    <Version>$(NetBenchVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildNumber" Value="$(NetBenchBuildNumber)" />
    <!-- Генератор desktop-скриншотов собирает окно из композиции (internal Composition) -->
    <InternalsVisibleTo Include="NetBench.Screenshots.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AdditionalFiles Include="Localization\i18n\*.i18n.json" />
    <AdditionalFiles Include="Localization\slang.json" />
  </ItemGroup>

  <!-- Мобильные таргеты компилируют только Plumix-презентацию (Mobile/), -->
  <ItemGroup Condition="'$(IsMobileTarget)' == 'true'">
    <!-- Тексты лицензий для экрана «Лицензии открытого ПО» (Mobile/Licenses/OssLicenses). -->
    <EmbeddedResource Include="Mobile\Licenses\*.txt" LogicalName="NetBench.Licenses.%(Filename).txt" />
    <!-- Начертания Inter для Plumix-UI (Mobile/Theme/NetBenchFonts): свои, без пакета Avalonia.Fonts.Inter. -->
    <EmbeddedResource Include="Mobile\Fonts\*.ttf" LogicalName="NetBench.Fonts.%(Filename)%(Extension)" />
    <Compile Remove="Desktop\**;Features\**\Presentation\Desktop\**" />
    <AvaloniaXaml Remove="Desktop\**;Features\**\Presentation\Desktop\**" />
    <!-- Android неявно импортирует Android.Widget — его ListView/Switch и т.п.
         конфликтуют с Plumix-виджетами; в общем коде Android API не нужен. -->
    <Using Remove="Android.Widget" Condition="$(TargetFramework.Contains('-android'))" />
  </ItemGroup>
  <!-- desktop-таргет — только Avalonia-презентацию (Desktop/). -->
  <ItemGroup Condition="'$(IsMobileTarget)' != 'true'">
    <Compile Remove="Mobile\**;Features\**\Presentation\Mobile\**" />
    <AvaloniaXaml Remove="Mobile\**;Features\**\Presentation\Mobile\**" />
  </ItemGroup>

  <!-- Avalonia: desktop и iOS-голова (на Android — нативный хост Plumix.Android без Avalonia) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0-android'">
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <!-- Общее: ядро движка -->
  <ItemGroup>
    <PackageReference Include="HdrHistogram" />
    <PackageReference Include="Slang.Net" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Desktop-презентация: MVVM + Pure.DI -->
  <ItemGroup Condition="'$(IsMobileTarget)' != 'true'">
    <PackageReference Include="Pure.DI" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Мобильная презентация: Plumix -->
  <ItemGroup Condition="'$(IsMobileTarget)' == 'true'">
    <PackageReference Include="Plumix.Bloc" />
    <PackageReference Include="Plumix.Slang" />
  </ItemGroup>
  <!-- Android: голова — PlumixActivity нативного хоста, Avalonia-бутстрап MobileApp не нужен -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-android'">
    <PackageReference Include="Plumix" />
    <PackageReference Include="Plumix.Material" />
    <Compile Remove="Mobile\MobileApp.axaml.cs" />
    <AvaloniaXaml Remove="Mobile\MobileApp.axaml" />
    <AvaloniaResource Remove="Assets\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-ios'">
    <PackageReference Include="Plumix" />
    <PackageReference Include="Plumix.Avalonia" />
    <PackageReference Include="Plumix.Material" />
  </ItemGroup>
</Project>
