<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.Report.Presentation.Desktop"
             xmlns:ctrl="using:NetBench.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="900"
             x:Class="NetBench.Features.Report.Presentation.Desktop.CompareView"
             x:DataType="vm:CompareViewModel">

    <UserControl.DataTemplates>
        <!-- Колонка сравнения -->
        <DataTemplate DataType="vm:CompareSide">
            <StackPanel>
                <Border Background="{DynamicResource BgCard}" CornerRadius="8" Padding="26,22">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource TextHi}" />
                        <TextBlock Classes="mono" Text="{Binding Target}"
                                   Foreground="{DynamicResource TextMid}" />
                        <TextBlock Classes="mono" Text="{Binding MetaText}" FontSize="12"
                                   Foreground="{DynamicResource TextDim}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,14,*,14,*" Margin="0,16,0,0">
                    <ctrl:MetricCard Grid.Column="0" Label="RPS" Tone="Rps" Value="{Binding RpsText}" />
                    <ctrl:MetricCard Grid.Column="2" Label="P95" Tone="Latency" Value="{Binding P95Text}" Unit="ms" />
                    <ctrl:MetricCard Grid.Column="4" Label="ОШИБКИ" Tone="{Binding ErrorTone}"
                                     Value="{Binding ErrorPctText}" Unit="%" />
                </Grid>
                <Border Background="{DynamicResource BgCard}" CornerRadius="8"
                        Padding="22,20" Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding LatencyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LatencyRow">
                                <ctrl:LatencyBar Margin="0,6"
                                                 Label="{Binding Label}"
                                                 Percentage="{Binding Percentage}"
                                                 Display="{Binding Display}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Margin="40,32">

            <TextBlock Classes="crumbs" Text="Сравнение отчётов" Margin="0,0,0,6" />
            <TextBlock Classes="h1" Text="Сравнение" Margin="0,0,0,20" />

            <Grid ColumnDefinitions="*,24,*">
                <StackPanel Grid.Column="0" Spacing="16">
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Options}"
                              SelectedItem="{Binding SelectedA}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CompareOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ContentControl Content="{Binding SideA}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="16">
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Options}"
                              SelectedItem="{Binding SelectedB}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CompareOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ContentControl Content="{Binding SideB}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                <Button Classes="ghost" Content="К отчёту" Command="{Binding BackCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
