<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.Shell.Presentation.Desktop"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="NetBench.Features.Shell.Presentation.Desktop.ShellView"
             x:DataType="vm:ShellViewModel">

    <Grid ColumnDefinitions="280,*">
        <ContentControl Grid.Column="0" Content="{Binding Sidebar}" />

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="Select a scenario to get started"
                           Foreground="Gray" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="Use ▶ to run, ✎ to edit, or create a new scenario"
                           Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
