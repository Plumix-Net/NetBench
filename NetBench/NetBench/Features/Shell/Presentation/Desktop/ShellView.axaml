<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.Shell.Presentation.Desktop"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="NetBench.Features.Shell.Presentation.Desktop.ShellView"
             x:DataType="vm:ShellViewModel">

    <Grid ColumnDefinitions="260,*" Background="{DynamicResource BgBase}">

        <!-- Сайдбар -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <ContentControl Content="{Binding Sidebar}" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">

            <!-- Контент -->
            <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

            <!-- Пустое состояние -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="14" IsVisible="{Binding IsEmpty}">
                <Border Width="56" Height="56" CornerRadius="14"
                        Background="{DynamicResource BgCard}"
                        HorizontalAlignment="Center">
                    <Path Data="M13,8 V18 M8,13 H18" Width="26" Height="26"
                          Stroke="{DynamicResource TextFaint}" StrokeThickness="1.6"
                          StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Пока нет сценариев" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
                <TextBlock Text="Создайте сценарий, чтобы начать нагрузочное тестирование."
                           Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
                <Button Classes="run" Margin="0,8,0,0" HorizontalAlignment="Center"
                        Content="+ Создать первый сценарий"
                        Command="{Binding Sidebar.AddScenarioCommand}" />
            </StackPanel>

            <!-- Нижняя панель запуска -->
            <Border Grid.Row="1" Height="60" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding IsRunBarVisible}">
                <Grid ColumnDefinitions="*,Auto" Margin="24,0">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding ActiveScenario.Name, FallbackValue=''}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" />
                        <TextBlock Classes="mono"
                                   Text="{Binding ActiveScenario.TargetLabel, FallbackValue=''}"
                                   FontSize="11" Foreground="{DynamicResource TextDim}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="Укажите Target URL, чтобы запустить"
                                   FontSize="11" Foreground="{DynamicResource Latency}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"
                                   IsVisible="{Binding ShowTargetHint}" />
                        <Button Classes="stop" Command="{Binding StopCommand}"
                                IsVisible="{Binding IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Rectangle Width="10" Height="10" Fill="{DynamicResource OnAccent}" />
                                <TextBlock Text="Стоп" />
                            </StackPanel>
                        </Button>
                        <Button Classes="run" Command="{Binding RunCommand}"
                                IsVisible="{Binding ShowRunButton}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M0,0 L10,5.5 L0,11 Z" Width="10" Height="11"
                                      Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                                <TextBlock Text="Запустить" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>

</UserControl>
