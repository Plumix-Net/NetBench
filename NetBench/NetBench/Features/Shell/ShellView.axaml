<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.Shell"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="NetBench.Features.Shell.ShellView"
             x:DataType="vm:ShellViewModel">

    <Grid ColumnDefinitions="280,*">
        <ContentControl Grid.Column="0" Content="{Binding Sidebar}" />
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>

</UserControl>
