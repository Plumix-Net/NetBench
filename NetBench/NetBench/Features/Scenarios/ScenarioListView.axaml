<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.Scenarios"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="700"
             x:Class="NetBench.Features.Scenarios.ScenarioListView"
             x:DataType="vm:ScenarioListViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Text="Scenarios"
                   Margin="16,16,16,8" FontWeight="SemiBold" FontSize="14" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Scenarios}"
                 SelectedItem="{Binding SelectedScenario}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="+ New Scenario"
                Command="{Binding AddScenarioCommand}"
                Margin="12,8" HorizontalAlignment="Stretch" />

    </Grid>

</UserControl>
