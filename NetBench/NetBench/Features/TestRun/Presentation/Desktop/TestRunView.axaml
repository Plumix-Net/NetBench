<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.TestRun.Presentation.Desktop"
             xmlns:ctrl="using:NetBench.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="840"
             x:Class="NetBench.Features.TestRun.Presentation.Desktop.TestRunView"
             x:DataType="vm:TestRunViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="40,32">

        <!-- Хлебные крошки: сценарий · target -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="crumbs" Text="{Binding Scenario.Name}" />
            <TextBlock Classes="crumbs" Text="·" />
            <TextBlock Classes="crumbs mono" Text="{Binding TargetLabel}" FontSize="12" />
        </StackPanel>

        <!-- Запись + прогресс -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,18">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse Classes="recdot" Width="8" Height="8" Fill="{DynamicResource Error}" />
                <TextBlock Text="ЗАПИСЬ" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Error}" LetterSpacing="0.6" />
            </StackPanel>
            <ProgressBar Grid.Column="1" Classes="slim" Margin="16,0"
                         Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                         VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding TimeLabel}"
                       FontSize="12" Foreground="{DynamicResource TextMid}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Live-метрики -->
        <Grid Grid.Row="2" ColumnDefinitions="*,14,*,14,*,14,*,14,*" Margin="0,0,0,24">
            <ctrl:MetricCard Grid.Column="0" Label="RPS" Tone="Rps" ShowDot="True"
                             Value="{Binding RpsText}" />
            <ctrl:MetricCard Grid.Column="2" Label="ЗАДЕРЖКА P95" Tone="Latency" ShowDot="True"
                             Value="{Binding P95Text}" Unit="ms" />
            <ctrl:MetricCard Grid.Column="4" Label="ОШИБКИ" ShowDot="True"
                             Tone="{Binding ErrorTone}"
                             Value="{Binding ErrorPctText}" Unit="%" />
            <ctrl:MetricCard Grid.Column="6" Label="ВСЕГО ЗАПРОСОВ"
                             Value="{Binding TotalText}" />
            <ctrl:MetricCard Grid.Column="8" Label="СОЕДИНЕНИЯ"
                             Value="{Binding ConnectionsText}" />
        </Grid>

        <!-- Графики -->
        <Grid Grid.Row="3" ColumnDefinitions="*,16,*" VerticalAlignment="Top">
            <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Classes="sechead" Text="ПРОПУСКНАЯ СПОСОБНОСТЬ (RPS)" />
                    <ctrl:LineChart Height="140" Points="{Binding RpsPoints}"
                                    Stroke="{DynamicResource Rps}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Classes="sechead" Text="ЗАДЕРЖКА P95 (МС)" />
                    <ctrl:LineChart Height="140" Points="{Binding P95Points}"
                                    Stroke="{DynamicResource Latency}" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</UserControl>
