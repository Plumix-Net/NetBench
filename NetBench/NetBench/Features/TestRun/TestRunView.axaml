<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.TestRun"
             xmlns:ctrl="using:NetBench.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="NetBench.Features.TestRun.TestRunView"
             x:DataType="vm:TestRunViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="{Binding Scenario.Name}"
                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="→" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Scenario.Target}"
                       Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Real-time metrics -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="RPS" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentStats.RequestsPerSecond, StringFormat={}{0:F0}}"
                               FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="p95 latency" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentStats.LatencyP95Ms, StringFormat={}{0:F0} ms}"
                               FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Errors" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentStats.ErrorRate, StringFormat={}{0:P1}}"
                               FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Total requests" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentStats.TotalRequests}"
                               FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Active conn." FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentStats.ActiveConnections}"
                               FontSize="32" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Charts -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*">
            <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="8" Margin="0,0,6,0" Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Throughput (RPS)"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,6" />
                    <ctrl:LineChart Grid.Row="1"
                                    Points="{Binding RpsPoints}"
                                    LineColor="#1E90FF" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#1A1A1A" CornerRadius="8" Margin="6,0,0,0" Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Latency p95 (ms)"
                               FontSize="11" Foreground="Gray" Margin="0,0,0,6" />
                    <ctrl:LineChart Grid.Row="1"
                                    Points="{Binding P95Points}"
                                    LineColor="#FFA500" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Stop" Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsRunning}" />
            <Button Content="Run" Command="{Binding StartCommand}"
                    IsEnabled="{Binding !IsRunning}" Classes="accent" />
        </StackPanel>

    </Grid>

</UserControl>
