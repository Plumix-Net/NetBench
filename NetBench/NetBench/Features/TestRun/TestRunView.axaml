<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NetBench.Features.TestRun"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="NetBench.Features.TestRun.TestRunView"
             x:DataType="vm:TestRunViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="{Binding Scenario.Name}"
                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="→" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Scenario.Target}"
                       Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Real-time metrics -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="RPS" FontSize="12" Foreground="Gray" />
                        <TextBlock Text="{Binding CurrentStats.RequestsPerSecond, StringFormat={}{0:F0}}"
                                   FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="p95 latency" FontSize="12" Foreground="Gray" />
                        <TextBlock Text="{Binding CurrentStats.LatencyP95Ms, StringFormat={}{0:F0} ms}"
                                   FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Errors" FontSize="12" Foreground="Gray" />
                        <TextBlock Text="{Binding CurrentStats.ErrorRate, StringFormat={}{0:P1}}"
                                   FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#1E1E1E" CornerRadius="8" Padding="20,12" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Total requests" FontSize="12" Foreground="Gray" />
                        <TextBlock Text="{Binding CurrentStats.TotalRequests}"
                                   FontSize="32" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Charts placeholder -->
            <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="8"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Text="Charts — LiveCharts2 (Phase 2)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Stop" Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsRunning}" />
            <Button Content="Run" Command="{Binding StartCommand}"
                    IsEnabled="{Binding !IsRunning}" Classes="accent" />
        </StackPanel>

    </Grid>

</UserControl>
