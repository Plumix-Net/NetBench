<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- ScreenOrientation.Portrait у MainActivity неявно делает android.hardware.screen.portrait обязательной:
	     Google Play тогда скрывает приложение на устройствах, чей профиль в Play эту функцию не заявляет
	     (так было с эмулятором Pixel 6a на android-37.1 ps16k: «Your device isn't compatible»).
	     Ориентация остаётся портретной, требование к устройству снимаем. -->
	<uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
	<!-- usesCleartextTraffic: нагрузочный тест часто бьёт в локальный/стейджинговый стенд по http:// —
	     без cleartext Android молча режет такие запросы, и прогон даёт 100% ошибок.
	     enableOnBackInvokedCallback: predictive back — PlumixMainActivity регистрирует
	     OnBackAnimationCallback, система показывает анимацию «назад на рабочий стол» на корне. -->
	<application
		android:label="NetBench"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:usesCleartextTraffic="true"
		android:enableOnBackInvokedCallback="true">
		<!-- Отдаёт файлы экспорта отчёта (cache/netbench-share) приложениям из меню «Поделиться». -->
		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/share_paths" />
		</provider>
	</application>
</manifest>
