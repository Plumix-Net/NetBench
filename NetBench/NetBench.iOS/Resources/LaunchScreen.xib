<?xml version="1.0" encoding="UTF-8"?>
<!-- Сплэш: фон темы (LaunchBackground, светлый/тёмный) и знак Plumix по центру (LaunchLogo).
     Ресурсы генерирует scripts/generate_icons.py. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
	<dependencies>
		<plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504" />
		<capability name="Named colors" minToolsVersion="9.0" />
		<capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
	</dependencies>
	<objects>
		<placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" />
		<placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder" />
		<view contentMode="scaleToFill" id="iN0-l3-epB">
			<rect key="frame" x="0.0" y="0.0" width="390" height="844" />
			<autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
			<subviews>
				<imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="Lgo-Pm-x01">
					<rect key="frame" x="135" y="362" width="120" height="120" />
					<constraints>
						<constraint firstAttribute="width" constant="120" id="Lgo-Wd-001" />
						<constraint firstAttribute="height" constant="120" id="Lgo-Ht-001" />
					</constraints>
				</imageView>
			</subviews>
			<color key="backgroundColor" name="LaunchBackground" />
			<constraints>
				<constraint firstItem="Lgo-Pm-x01" firstAttribute="centerX" secondItem="iN0-l3-epB" secondAttribute="centerX" id="Lgo-Cx-001" />
				<constraint firstItem="Lgo-Pm-x01" firstAttribute="centerY" secondItem="iN0-l3-epB" secondAttribute="centerY" id="Lgo-Cy-001" />
			</constraints>
			<point key="canvasLocation" x="0" y="0" />
		</view>
	</objects>
	<resources>
		<image name="LaunchLogo" width="120" height="120" />
		<namedColor name="LaunchBackground">
			<color red="0.961" green="0.965" blue="0.973" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
		</namedColor>
	</resources>
</document>
