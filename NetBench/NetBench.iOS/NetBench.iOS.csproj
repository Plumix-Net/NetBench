<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <!-- Идентичность и версия — из Directory.Build.props, в Info.plist их нет (MSBuild вписывает сам). -->
    <ApplicationId>$(NetBenchApplicationId)</ApplicationId>
    <ApplicationTitle>NetBench</ApplicationTitle>
    <ApplicationVersion>$(NetBenchBuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(NetBenchVersion)</ApplicationDisplayVersion>
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <!-- Release под устройство (App Store / TestFlight): сертификат и профиль приходят снаружи —
       -p:CodesignKey="Apple Distribution: ..." -p:CodesignProvision="<имя профиля>"
       (локально — из связки ключей, в CI — секреты); без них берётся любой «Apple Distribution» из связки ключей. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
    <BuildIpa Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">true</BuildIpa>
    <CodesignKey Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and '$(CodesignKey)' == ''">Apple Distribution</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <!-- Манифест приватности должен лежать в корне бандла. -->
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetBench\NetBench.csproj" />
  </ItemGroup>
</Project>
