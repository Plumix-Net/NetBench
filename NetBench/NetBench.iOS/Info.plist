<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CFBundleIdentifier, CFBundleShortVersionString, CFBundleVersion и CFBundleDisplayName
	     вписывает сборка из NetBench.iOS.csproj (ApplicationId/…Version/ApplicationTitle). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>
	<!-- Только iPhone и только портрет: вёрстка рассчитана на телефон в вертикальной ориентации. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Только HTTPS из System.Net/Apple TLS, своей криптографии нет — экспортная декларация не нужна. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Цели нагрузочного теста бывают и по http:// (локальные и стейджинговые стенды) — ATS их
	     иначе блокирует. Обоснование для App Review — в store/app-review-notes.md. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- iOS 14+ спрашивает разрешение на доступ к локальной сети, когда цель — адрес в LAN. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>NetBench sends test requests to the servers you enter, including ones on your local network.</string>
</dict>
</plist>
